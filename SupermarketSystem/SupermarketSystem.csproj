<Project Sdk="Microsoft.NET.Sdk">

  <!-- مشروع Windows Forms على .NET Framework 4.8 (يُفتح في Visual Studio 2019 أو أحدث) -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <RootNamespace>SupermarketSystem</RootNamespace>
    <AssemblyName>SupermarketSystem</AssemblyName>
    <LangVersion>7.3</LangVersion>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Title>نظام إدارة وتشغيل سوبرماركت</Title>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Data" />
  </ItemGroup>

  <ItemGroup>
    <!-- قاعدة بيانات SQLite المدمجة (تُنزَّل تلقائياً من NuGet عند أول بناء) -->
    <PackageReference Include="System.Data.SQLite.Core" Version="1.0.118" />
  </ItemGroup>

</Project>
